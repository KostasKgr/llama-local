{
  "promptTimeoutMs": 1000,
  "permission": {
    "*": "deny",
    "mcp": "deny",
    "write": "deny",
    "edit": "deny",
    "path_write": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "deny",
      "orca-ide skills get *": "deny",
      "orca-ide tab list *": "deny",
      "orca-ide computer get-app-state *": "deny",
      "orca-ide computer list-windows *": "deny",
