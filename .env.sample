# Copy this file to .env (git-ignored) and edit it.
#
# LLAMA_PI_BASE_URL: base URL registered for the llama-local PI provider by
# `python3 llama.py pi add`. It applies to every model under that provider.
# LLAMA_OPENCODE_BASE_URL: base URL registered for the llama.cpp OpenCode
# provider by `python3 llama.py opencode add`. It applies to every model
# under that provider.
# Leave a key unset to register against the local server at
# http://127.0.0.1:<port>/v1.
#LLAMA_PI_BASE_URL=https://example.com/v1
#LLAMA_OPENCODE_BASE_URL=https://example.com/v1
