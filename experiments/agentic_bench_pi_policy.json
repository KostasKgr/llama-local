      "orca-ide goto --url *": "deny",
      "printenv ORCA_CLI_COMMAND ORCA_DEV_REPO_ROOT": "deny",
      "task agent:verify": "deny",
      "task build": "deny",
      "task test": "deny",
      "task fmt-check": "deny",
      "task check": "deny",
      "pwd": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sed -n *": "allow",
      "sed -n *-i*": "deny",
      "echo *": "allow",
      "grep *": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "file *": "allow",
      "which *": "allow",
      "jq *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "du *": "allow",
      "df *": "allow",
      "cd *": "allow",
