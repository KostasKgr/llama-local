      "go vet *": "deny",
      "go test *": "deny",
      "go build *": "deny",
      "go mod tidy": "deny",
      "gofmt*": "deny",
      "python3 -m unittest *": "deny",
      "node --test *": "deny",
      "node --check *": "deny",
      "node --version": "deny",
      "pnpm outdated *": "deny",
      "find *-fprint*": "deny",
      "rg *--pre*": "deny"
